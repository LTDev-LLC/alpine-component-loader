{
  "version": 1,
  "components": {
    "account-dashboard": {
      "source": "components/account-dashboard.html",
      "dependencies": [
        "profile-avatar"
      ],
      "options": {
        "attributes": {
          "accountId": {
            "type": "String",
            "required": true
          },
          "plan": {
            "type": "String",
            "default": "starter",
            "options": [
              "starter",
              "pro"
            ]
          }
        },
        "templateRevision": "sha256-3ZaMbVeudZTi8DAhivDG9lTZw1XoDP-K_17DK-blJTI"
      },
      "metadata": {
        "description": "Account route demonstrating group roots, inferred dependencies, props, and events.",
        "events": {
          "plan-change": {
            "description": "Emitted when the example plan changes.",
            "detail": {
              "type": "object",
              "properties": {
                "plan": {
                  "type": "string"
                }
              },
              "required": [
                "plan"
              ]
            }
          }
        }
      }
    },
    "home-dashboard": {
      "source": "components/home-dashboard.html",
      "dependencies": [
        "quantity-field"
      ],
      "options": {
        "attributes": {
          "visitor": {
            "type": "String",
            "default": "developer"
          }
        },
        "templateRevision": "sha256-QVB1zo_d0l_pzWVeTmuLBdRvrb-JPlsGrhmWQN-sCo0"
      },
      "metadata": {
        "slots": {
          "tip": {
            "description": "Route-specific guidance supplied by the application router."
          }
        },
        "description": "Home route demonstrating dependency expansion, slots, and form association."
      }
    },
    "profile-avatar": {
      "source": "components/profile-avatar.html",
      "dependencies": [],
      "options": {
        "shadow": true,
        "attributes": {
          "initials": {
            "type": "String",
            "required": true
          }
        },
        "templateRevision": "sha256-pV-sW98ZtaeSaDULQZEf8ZhBNk6zub3gI_pHOjHu7AQ"
      },
      "metadata": {
        "description": "Shadow DOM dependency inferred from the account dashboard template."
      }
    },
    "quantity-field": {
      "source": "components/quantity-field.html",
      "dependencies": [],
      "options": {
        "shadow": true,
        "attributes": {
          "quantity": {
            "type": "Number",
            "default": 1
          },
          "disabledState": "Boolean"
        },
        "form": {
          "value": "quantity",
          "state": "quantity",
          "disabled": "disabledState"
        },
        "templateRevision": "sha256-EDefMLOaxHDGhQDOdj6_LFjN7fVd06TIaOYb91jRfUU"
      },
      "metadata": {
        "description": "A form-associated quantity control.",
        "events": {
          "quantity-change": {
            "description": "Emitted after the quantity changes."
          }
        }
      }
    }
  },
  "groups": {
    "account": [
      "account-dashboard"
    ],
    "home": [
      "home-dashboard"
    ]
  }
}
