{
    "arrowParens": "always",
    "bracketSpacing": true,
    "objectWrap": "preserve",
    "printWidth": 120,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "all",
    "useTabs": false,
    "overrides": [
        {
            "files": ["**/*.md", "**/*.markdown", "**/*.mdx"],
            "options": {
                "proseWrap": "always",
                "embeddedLanguageFormatting": "off"
            }
        },
        {
            "files": "**/*.html.tmpl",
            "options": {
                "parser": "html"
            }
        }
    ]
}
