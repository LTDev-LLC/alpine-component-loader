{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "strict": true,
        "noEmit": true,
        "incremental": true,
        "tsBuildInfoFile": "node_modules/.cache/acl-implementation.tsbuildinfo",
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": [
        "scripts/check-lean-install.mjs",
        "scripts/check-size.mjs",
        "server/file-writer.mjs",
        "server/javascript-minifier.mjs",
        "server/optional-dependency.mjs"
    ]
}
